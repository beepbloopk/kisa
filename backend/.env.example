# Copy this file to .env in the same folder, then fill in the values.
# Never commit .env. It holds keys, and this repository is public.

# Supabase project URL, from Project Settings > API.
SUPABASE_URL=

# Supabase API key. Use the anon (publishable) key. The service_role or
# secret key must never be committed anywhere.
SUPABASE_KEY=

# Google Gemini API key, from Google AI Studio.
GEMINI_API_KEY=
